# SQLite path. Leave unset locally (defaults to ./bets.db).
# On Render, point this at a mounted disk to survive redeploys, e.g. /var/data/bets.db
# DB_PATH=

# The Odds API key (https://the-odds-api.com) — used by the odds pipeline.
ODDS_API_KEY=

# Optional overrides for the odds pipeline.
# ODDS_API_SPORT_KEY=soccer_fifa_world_cup
# ODDS_API_REGIONS=eu

# Shared secret for the cron-triggered odds pull endpoint.
# Generate any random string and set the same value in cron-job.org as
# ?key=... or header x-cron-key.
CRON_SECRET=
